{
  "name": "@crank/graphics-core",
  "version": "0.1.0",
  "description": "Shared core utilities for Crank graphics packages",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "crank",
    "graphics",
    "core",
    "shared",
    "utilities"
  ],
  "author": "Crank Contributors",
  "license": "MIT",
  "peerDependencies": {
    "@b9g/crank": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
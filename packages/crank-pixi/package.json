{
  "name": "@b9g/crank-pixi",
  "version": "0.1.0",
  "description": "Pixi.js renderer for Crank",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "libuild build",
    "publish": "libuild publish",
    "typecheck": "tsc --noEmit",
    "generate": "./scripts/generate-pixi-objects.ts",
    "test": "libuild test test/ -p chromium",
    "prepublishOnly": "echo 'ERROR: Cannot publish from the package root. Use libuild publish instead.' && exit 1"
  },
  "keywords": [
    "crank",
    "pixi.js",
    "renderer",
    "canvas",
    "webgl"
  ],
  "author": "Brian Kim <hello@b9g.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bikeshaving/crank-graphics.git",
    "directory": "packages/crank-pixi"
  },
  "bugs": {
    "url": "https://github.com/bikeshaving/crank-graphics/issues"
  },
  "homepage": "https://github.com/bikeshaving/crank-graphics/tree/main/packages/crank-pixi#readme",
  "peerDependencies": {
    "@b9g/crank": "^0.7.0",
    "pixi.js": "^8.12.0"
  },
  "devDependencies": {
    "@b9g/libuild": "^0.2.18",
    "@types/node": "^20.0.0",
    "playwright": "^1.62.1",
    "ts-morph": "^21.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}

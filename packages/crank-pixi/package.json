{
  "name": "@b9g/crank-pixi",
  "version": "0.1.0",
  "description": "Pixi.js renderer for Crank",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "generate": "./scripts/generate-pixi-objects.ts",
    "test": "playwright-test --runner uvu"
  },
  "keywords": [
    "crank",
    "pixi.js",
    "renderer",
    "canvas",
    "webgl"
  ],
  "author": "Brian Kim <hello@b9g.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bikeshaving/crank-graphics.git",
    "directory": "packages/crank-pixi"
  },
  "bugs": {
    "url": "https://github.com/bikeshaving/crank-graphics/issues"
  },
  "homepage": "https://github.com/bikeshaving/crank-graphics/tree/main/packages/crank-pixi#readme",
  "peerDependencies": {
    "@b9g/crank": "^0.7.0",
    "pixi.js": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/sinon": "^17.0.4",
    "playwright-test": "^14.1.9",
    "sinon": "^17.0.2",
    "ts-morph": "^21.0.0",
    "tsx": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "uvu": "^0.5.6"
  }
}

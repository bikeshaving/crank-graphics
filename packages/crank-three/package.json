  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@b9g/crank": "^0.7.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@b9g/libuild": "^0.2.18",
    "@types/node": "^20.0.0",
    "@types/three": "^0.170.0",

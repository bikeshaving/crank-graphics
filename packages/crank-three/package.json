{
  "name": "@b9g/crank-three",
  "version": "0.1.0",
  "description": "Three.js renderer for Crank",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "generate": "./scripts/generate-three-objects.ts",
    "test": "playwright-test --runner uvu"
  },
  "keywords": [
    "crank",
    "three.js",
    "threejs",
    "renderer",
    "3d",
    "webgl"
  ],
  "author": "Brian Kim <hello@b9g.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bikeshaving/crank-graphics.git",
    "directory": "packages/crank-three"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@b9g/crank": "^0.7.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/sinon": "^17.0.4",
    "@types/three": "^0.170.0",
    "playwright-test": "^14.1.9",
    "sinon": "^17.0.2",
    "three": "^0.170.0",
    "ts-morph": "^21.0.0",
    "tsx": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "uvu": "^0.5.6"
  }
}

{
  "name": "@b9g/crank-graphics",
  "version": "0.1.0",
  "description": "Graphics rendering packages for Crank.js - supporting Pixi.js, Three.js and more",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run clean && bun run --filter='./packages/*' build",
    "clean": "rm -rf packages/*/dist",
    "test": "bun run --filter='./packages/*' test",
    "typecheck": "bun run --filter='./packages/*' typecheck",
    "generate": "bun run --filter='./packages/*' generate"
  },
  "keywords": [
    "crank",
    "graphics",
    "pixi",
    "pixijs", 
    "threejs",
    "three",
    "webgl",
    "2d",
    "3d",
    "canvas",
    "renderer"
  ],
  "author": "Brian Kim <hello@b9g.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bikeshaving/crank-graphics.git"
  },
  "bugs": {
    "url": "https://github.com/bikeshaving/crank-graphics/issues"
  },
  "homepage": "https://github.com/bikeshaving/crank-graphics#readme",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}